# PostgreSQL connection string. Replit provisions this automatically;
# for other hosts, use your provider's connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random secret used to sign session cookies. Generate a strong value in
# production, e.g.: openssl rand -base64 48
SESSION_SECRET=

# Optional comma-separated UUID allowlist for platform administration.
# Do not use usernames as proof of administrator access.
PLATFORM_ADMIN_USER_IDS=

# Authentication throttling defaults to 12 attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=12
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Maximum invoice discount percentage. Staff defaults to 10%; owners default to 100%.
STAFF_MAX_DISCOUNT_PERCENT=10
OWNER_MAX_DISCOUNT_PERCENT=100

# Server port (defaults to 5000 if unset)
PORT=5000

# development | production
NODE_ENV=development
